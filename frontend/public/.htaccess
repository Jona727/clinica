# Sirve index.html para cualquier ruta que no sea un archivo real,
# para que las rutas de React Router (ej. /turnos, /pacientes) funcionen
# al entrar directo o al recargar la página, no solo navegando desde "/".
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
